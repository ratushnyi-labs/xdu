# Build target triple. Override per build.
# Supported in v0.1.0:
#   x86_64-unknown-linux-musl   (default; fully static)
#   aarch64-unknown-linux-musl  (fully static)
#   x86_64-pc-windows-gnu       (statically linked C runtime via mingw)
TARGET=x86_64-unknown-linux-musl

# Hard ceiling for the produced binary in bytes. Build fails if exceeded.
# Default: 1572864 = 1.5 MiB (per ADR-001 §4).
SIZE_CEILING_BYTES=1572864
